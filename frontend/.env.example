# Frontend Environment Variables
# Copy this file to .env.local and update values

# API Configuration
# Development: http://localhost:3000
# Production: https://bayanihub-api.onrender.com
VITE_API_URL=http://localhost:3000

# Stripe publishable key (never use the secret key in the frontend).
# Replace this placeholder with a test-mode pk_test_* value for the demo.
VITE_STRIPE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Node Environment
VITE_ENV=development
