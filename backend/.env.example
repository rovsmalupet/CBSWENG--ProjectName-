# ─────────────────────────────────────────────────────────────────────────────
# BayaniHub backend environment
#
# Copy to `.env` and fill in real values. NEVER commit `.env` — it is gitignored.
# The server refuses to start if any REQUIRED variable is missing or weak
# (see backend/security/env.js). That is deliberate: failing to boot is safer
# than silently running with an undefined signing key. [CSSECDV 2.1.2]
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# PostgreSQL. `DATABASE_URL` is the pooled connection, `DIRECT_URL` bypasses the
# pooler for migrations.
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://user:password@host:port/database?sslmode=require"

# JWT signing key. MUST be at least 32 characters of high-entropy random data.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating this value immediately invalidates every issued session token.
JWT_SECRET=""

# ── STRONGLY RECOMMENDED ─────────────────────────────────────────────────────

NODE_ENV="development"          # use "production" for the demo and for deploys
PORT=3000

# Comma-separated allowlist of browser origins permitted to call this API.
FRONTEND_URL="http://localhost:5173"

# ── PASSWORD RESET EMAIL (required for the forgot-password flow) ─────────────

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-address@example.com"
SMTP_PASS=""                    # app password, not your account password
EMAIL_FROM="BayaniHub <no-reply@example.com>"
RESET_PASSWORD_URL="http://localhost:5173/reset-password"

# ── PAYMENTS ─────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=""

# ── SEED ACCOUNTS ────────────────────────────────────────────────────────────
#
# Passwords for the demo accounts created by `npm run db:seed`. Each must
# satisfy the password policy (12-64 chars, upper + lower + digit + symbol).
# If unset, the seed generates a random password and prints it once to stdout —
# it is never written to source. [CSSECDV 2.1.3, 2.1.5, 2.1.6]

SEED_ADMIN_PASSWORD=""
SEED_NGO_PASSWORD=""
SEED_DONOR_PASSWORD=""

# ── SECURITY TUNING (optional — sane defaults in backend/security/env.js) ────

# Failed logins before an account locks. [2.1.8]
# LOCKOUT_THRESHOLD=5
# How long an account stays locked, in minutes. Long enough to make brute force
# useless, short enough that lockout is not itself a denial-of-service. [2.1.8]
# LOCKOUT_DURATION_MINUTES=15
# Session token lifetime, in minutes.
# ACCESS_TOKEN_TTL_MINUTES=30
# Minimum hours between self-service password changes. [2.1.11]
# PASSWORD_MIN_AGE_HOURS=24
# How many previous passwords are remembered and refused. [2.1.10]
# PASSWORD_HISTORY_DEPTH=5
