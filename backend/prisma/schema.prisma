generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// AUTHENTICATION
//
// UserAccount owns *authentication*; Admin / Donor / Organization remain the
// *profile* tables and link to it 1:1.
//
// Why unify? Every control in CSSECDV section 2.1 — lockout counters, password
// history, password age, last-use reporting, security questions — is a property
// of "a login", not of "an NGO" or "a donor". With three password columns each
// control had to be written three times and kept in sync forever. One table,
// one implementation, one place to audit.
//
// Profile ids are deliberately NOT merged into this table: Post.orgId,
// DonorOrganizationPartner.donorId and Payment.userId all reference profile ids,
// and the JWT keeps carrying the profile id as `req.user.id` so none of that
// downstream code had to change.
// ═══════════════════════════════════════════════════════════════════════════

model UserAccount {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String // bcrypt, cost 12 — see security/passwordPolicy.js [2.1.3]
  role         UserRole
  status       AccountState @default(Active)

  // ── Account lockout [2.1.8] ──────────────────────────────────────────────
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // ── Password lifecycle [2.1.11] ──────────────────────────────────────────
  passwordChangedAt DateTime @default(now())
  // Lets an admin-provisioned account bypass the minimum-age rule exactly once,
  // so a forced reset is not blocked by the control it just triggered.
  mustChangePassword Boolean @default(false)

  // ── Last-use reporting [2.1.12] ──────────────────────────────────────────
  // Read and returned to the user at their next successful login, *before*
  // being overwritten.
  lastLoginAt              DateTime?
  lastLoginIp              String?
  lastFailedLoginAt        DateTime?
  lastFailedLoginIp        String?
  failedAttemptsSinceLogin Int       @default(0)

  // ── Session revocation ───────────────────────────────────────────────────
  // Embedded in every JWT and compared on every request. Incrementing it
  // instantly invalidates all outstanding tokens for this account — used on
  // logout, password change, role change, and account disable. Without this a
  // stolen token stays valid until it expires no matter what the user does.
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin        Admin?
  donor        Donor?
  organization Organization?

  passwordHistory PasswordHistory[]
  securityAnswers SecurityAnswer[]
  resetTokens     PasswordResetToken[]
  securityLogs    SecurityLog[]

  @@index([role, status])
}

/// Previous password hashes, newest first. [2.1.10]
/// Retention is capped at config.passwordHistoryDepth; older rows are pruned.
model PasswordHistory {
  id           String      @id @default(uuid())
  accountId    String
  account      UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime    @default(now())

  @@index([accountId, createdAt])
}

/// Answers to password-reset questions. [2.1.9]
/// The answer is normalized then bcrypt-hashed — it is a credential, so it is
/// stored exactly the way a password is and is never returned by any endpoint.
model SecurityAnswer {
  id          String      @id @default(uuid())
  accountId   String
  account     UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  questionKey String // key into the catalogue in security/securityQuestions.js
  answerHash  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([accountId, questionKey])
}

enum UserRole {
  admin
  ngo
  donor
}

enum AccountState {
  Active // may sign in
  Pending // registered, awaiting admin approval — may not sign in
  Disabled // soft-deleted or suspended by an admin
  Rejected // registration denied
}

// ═══════════════════════════════════════════════════════════════════════════
// SECURITY LOG  [2.4.3 – 2.4.7]
//
// Append-only. There is no update or delete path in the service or the API,
// and the only read surface is admin-restricted. [2.4.4]
// ═══════════════════════════════════════════════════════════════════════════

model SecurityLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  eventType String // see security/securityLog.js EVENTS
  outcome   LogOutcome
  severity  LogSeverity @default(INFO)

  actorAccountId String?
  actor          UserAccount? @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  // Recorded separately because a failed login often has no resolvable account,
  // and because the account row may later be deleted.
  actorEmail     String?
  actorRole      String?

  ipAddress  String?
  userAgent  String?
  httpMethod String?
  route      String?

  targetType String? // "Post", "Payment", "UserAccount", ...
  targetId   String?

  message  String
  metadata Json? // redacted before write — never secrets

  @@index([createdAt])
  @@index([eventType, outcome])
  @@index([actorAccountId])
  @@index([ipAddress])
  @@index([severity])
}

enum LogOutcome {
  SUCCESS
  FAILURE
}

enum LogSeverity {
  INFO
  WARN
  CRITICAL
}

// ORGANIZATION

model Organization {
  id         String        @id @default(uuid())
  accountId  String        @unique
  account    UserAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orgName    String
  firstName  String
  surname    String
  email      String        @unique
  country    ASEANCountry  @default(Philippines)
  bio        String? // org mission statement / about section
  isVerified Boolean       @default(false)
  status     AccountStatus @default(Pending)
  createdAt  DateTime      @default(now())

  posts         Post[]
  donorPartners DonorOrganizationPartner[]
}

// DONOR

model Donor {
  id          String        @id @default(uuid())
  accountId   String        @unique
  account     UserAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String        @unique
  country     ASEANCountry  @default(Philippines)
  affiliation String // company or organization they represent
  bio         String? // personal bio / about me
  isVerified  Boolean       @default(false)
  status      AccountStatus @default(Pending)
  createdAt   DateTime      @default(now())

  partnerOrgs DonorOrganizationPartner[]
}

// ADMIN

model Admin {
  id        String      @id @default(uuid())
  accountId String      @unique
  account   UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String      @unique
  createdAt DateTime    @default(now())

  auditLogs PostAuditLog[]
}

// POST

model Post {
  id              String       @id @default(uuid())
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  projectName     String
  description     String?
  budgetBreakdown Json?
  causes          CauseEnum[]
  location        String?
  priority        Priority     @default(Medium)
  overallStatus   PostStatus   @default(Pending)
  startDate       DateTime?
  endDate         DateTime?
  startTime       String?
  endTime         String?
  createdAt       DateTime     @default(now())

  supportOptions PostSupportOption[]
  inKindItems    PostInKindItem[]
  contributions  Contribution[]
  auditLogs      PostAuditLog[]
  documents      DocumentUpload[]
  payments       Payment[]
  refunds        Refund[]
}

// POST AUDIT LOG
// Records every admin action taken on a post.
model PostAuditLog {
  id        String     @id @default(uuid())
  postId    String
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  adminId   String
  admin     Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    PostStatus // the status that was set
  createdAt DateTime   @default(now())
}

model DocumentUpload {
  id          String       @id @default(uuid())
  postId      String
  post        Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    DocumentType
  filePath    String
  fileSize    Int
  mimeType    String?
  uploadedBy  String
  description String?
  createdAt   DateTime     @default(now())
}

// POST SUPPORT OPTION

// Each row represents one support type (Monetary or Volunteer) for a post.
// A post can only have one row per type, enforced by @@unique.
model PostSupportOption {
  id     String      @id @default(uuid())
  postId String
  post   Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  type   SupportType

  // Monetary fields
  targetAmount  Float?
  currentAmount Float  @default(0)

  // Volunteer fields
  targetCount  Int?
  currentCount Int  @default(0)

  status SupportStatus @default(Open)

  @@unique([postId, type])
}

// POST IN-KIND ITEM

model PostInKindItem {
  id              String        @id @default(uuid())
  postId          String
  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  itemName        String
  targetQuantity  Float
  currentQuantity Float         @default(0)
  unit            String?
  pricePerUnit    Float? // price per unit for transaction fee calculation
  status          SupportStatus @default(Open)

  contributions Contribution[]
}

// CONTRIBUTION
// Records every donation, whether submitted by a registered donor or manually
// logged by the org on behalf of a walk-in/unregistered donor.
// - donorName is always filled (org types this in for manual entries)
// - partnershipId is null for manual entries, populated for registered donors
model Contribution {
  id            String                    @id @default(uuid())
  donorName     String // always filled
  partnershipId String? // null for unregistered donors
  partnership   DonorOrganizationPartner? @relation(fields: [partnershipId], references: [id], onDelete: SetNull)
  postId        String
  post          Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  type          SupportType

  // Monetary — only populated when type = Monetary
  amount Float?

  // Volunteer — only populated when type = Volunteer
  volunteerCount Int?

  // InKind — only populated when type = InKind
  inKindItemId String?
  inKindItem   PostInKindItem? @relation(fields: [inKindItemId], references: [id], onDelete: SetNull)
  quantity     Float?

  // Optional proof of donation upload from donor
  proofFileName String?
  proofFilePath String?
  proofMimeType String?
  proofFileSize Int?

  status    ContributionStatus @default(Pending)
  createdAt DateTime           @default(now())

  // Progress totals on PostSupportOption / PostInKindItem are only moved when a
  // contribution reaches Confirmed. Before this, totals were incremented the
  // moment a row was created — so anyone could inflate a project's fundraising
  // bar without the organization ever agreeing. [2.2.3]
  statusChangedAt DateTime?
  statusChangedBy String? // profile id of the org user who confirmed/declined

  @@index([postId, status])
  @@index([partnershipId])
}

// DONOR ORGANIZATION PARTNER
// Represents an ongoing relationship between a registered donor and an org.
// Created when a registered donor's contribution is confirmed.
// contributions[] holds all confirmed contributions made by this donor to this org.
model DonorOrganizationPartner {
  id            String         @id @default(uuid())
  donorId       String
  donor         Donor          @relation(fields: [donorId], references: [id], onDelete: Cascade)
  orgId         String
  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status        String         @default("pending") // pending, approved, rejected
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contributions Contribution[]

  @@unique([donorId, orgId])
}

// PASSWORD RESET TOKEN
//
// The reset flow requires TWO independent factors before a password changes:
//   1. possession of the emailed token (proves control of the mailbox), and
//   2. correct answers to the account's security questions [2.1.9].
// Holding one without the other is not enough.
//
// The token itself is 32 random bytes, stored only as a SHA-256 hash, single
// use, and expiring in 24 hours — that design was already sound and is kept.
model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String // email of user requesting password reset
  token     String   @unique // SHA-256 of the token that was emailed
  expiresAt DateTime // 24 hours from creation
  isUsed    Boolean  @default(false) // true once a password has been set with it
  createdAt DateTime @default(now())

  accountId String?
  account   UserAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // ── Security-question gate [2.1.9] ───────────────────────────────────────
  // The new-password step refuses to run until answersVerifiedAt is set.
  answersVerifiedAt DateTime?
  answerAttempts    Int       @default(0)
  // Set once answerAttempts hits the limit; burns the token so an attacker
  // cannot grind the questions.
  lockedAt          DateTime?

  @@index([email])
  @@index([expiresAt])
}

// PAYMENT
// Records transaction fees paid through Stripe
model Payment {
  id              String  @id @default(uuid())
  paymentIntentId String  @unique // Stripe payment intent ID
  currency        String  @default("PHP")
  status          String // "succeeded", "processing", "requires_action", etc.
  description     String?

  postId String? // which project/post this payment is for (null for admin donations)
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId   String // who made the payment (donor or org ID)
  userRole String // "donor" or "ngo"

  // Payment breakdown
  monetaryContribution   Float @default(0) // actual donation amount
  monetaryTransactionFee Float @default(0) // 3% of monetary donation
  volunteerTransactionFee Float @default(0) // 50 PHP per volunteer (capped at 500)
  inKindTransactionFee   Float @default(0) // 3% of in-kind donation

  // Refund tracking
  refundIntentId String? // Stripe refund ID (if refunded)
  refundedAt     DateTime? // when the refund was processed
  refundStatus   String? // "succeeded", "failed", "pending"
  refundAmount   Float? // refunded amount (may be partial)
  refundReason   String? // reason for refund (e.g., "contribution_declined")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Refund    Refund?
}

// REFUND
// Records all refund transactions separately for audit trail
model Refund {
  id        String  @id @default(uuid())
  paymentId String  @unique // link back to original payment
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  refundIntentId String  @unique // Stripe refund transaction ID
  amount         Float // amount refunded in PHP
  currency       String  @default("PHP")
  status         String // "succeeded", "failed", "pending"
  reason         String? // reason for refund

  // Context
  contributionId  String? // which contribution was declined (if applicable)
  processedBy     String? // admin ID who processed this refund
  processedByRole String? // "admin" or "system"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Post      Post?    @relation(fields: [postId], references: [id])
  postId    String?
}

// ENUMS

enum ASEANCountry {
  Brunei
  Cambodia
  Indonesia
  Laos
  Malaysia
  Myanmar
  Philippines
  Singapore
  Thailand
  Vietnam
}

enum SupportType {
  Monetary
  Volunteer
  InKind
}

enum CauseEnum {
  noPoverty // SDG 1  — No Poverty
  zeroHunger // SDG 2  — Zero Hunger
  goodHealth // SDG 3  — Good Health and Well-being
  qualityEducation // SDG 4  — Quality Education
  genderEquality // SDG 5  — Gender Equality
  cleanWater // SDG 6  — Clean Water and Sanitation
  affordableEnergy // SDG 7  — Affordable and Clean Energy
  decentWork // SDG 8  — Decent Work and Economic Growth
  industry // SDG 9  — Industry, Innovation and Infrastructure
  reducedInequalities // SDG 10 — Reduced Inequalities
  sustainableCities // SDG 11 — Sustainable Cities and Communities
  responsibleConsumption // SDG 12 — Responsible Consumption and Production
  climateAction // SDG 13 — Climate Action
  lifeBelowWater // SDG 14 — Life Below Water
  lifeOnLand // SDG 15 — Life on Land
  peaceAndJustice // SDG 16 — Peace, Justice and Strong Institutions
  partnerships // SDG 17 — Partnerships for the Goals
  others
}

enum Priority {
  High
  Medium
  Low
}

enum PostStatus {
  Pending
  Approved
  Unapproved
  Edited
  Deleted
}

enum SupportStatus {
  Open
  Closed
}

enum AccountStatus {
  Pending // just registered, not yet reviewed
  Approved // verified and active
  Rejected // denied by admin
  Active // approved and currently active
}

enum ContributionStatus {
  Pending // logged, waiting for org to confirm
  Confirmed // org verified the contribution
  Declined // org rejected the contribution
}

enum DocumentType {
  Photo
  Receipt
  Report
  Update
  Documentation
  Certification
  Compliance
  Certificate
  Other
}
